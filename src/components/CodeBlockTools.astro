<script>
	document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
		const code = pre.querySelector('code');
		if (!code || pre.closest('.article-code-block')) return;

		const wrapper = document.createElement('div');
		wrapper.className = 'article-code-block';
		const toolbar = document.createElement('div');
		toolbar.className = 'code-block-toolbar';
		toolbar.setAttribute('role', 'group');
		toolbar.setAttribute('aria-label', 'Code block actions');

		const status = document.createElement('span');
		status.className = 'code-block-status';
		status.setAttribute('role', 'status');
		status.setAttribute('aria-live', 'polite');
		status.setAttribute('aria-atomic', 'true');

		const feedback = document.createElement('span');
		feedback.className = 'code-block-feedback';
		const check = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
		check.classList.add('code-copy-check');
		check.setAttribute('viewBox', '0 0 20 20');
		check.setAttribute('aria-hidden', 'true');
		const checkPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
		checkPath.setAttribute('d', 'M 4 10 L 8 14 L 16 6');
		check.append(checkPath);
		feedback.append(check, status);

		const copy = document.createElement('button');
		copy.type = 'button';
		copy.className = 'code-copy-button';
		copy.textContent = 'Copy';
		copy.setAttribute('aria-label', 'Copy code block');

		let successTimeout: number | undefined;
		let feedbackAnimations: Animation[] = [];
		const resetFeedback = () => {
			window.clearTimeout(successTimeout);
			successTimeout = undefined;
			feedbackAnimations.forEach((animation) => animation.cancel());
			feedbackAnimations = [];
			delete toolbar.dataset.copyState;
			status.textContent = '';
		};

		copy.addEventListener('click', async () => {
			resetFeedback();
			if (!navigator.clipboard?.writeText) {
				status.textContent = 'Clipboard unavailable. Select the text to copy manually.';
				console.warn('Clipboard access is unavailable for article code blocks.');
				return;
			}

			copy.disabled = true;
			try {
				await navigator.clipboard.writeText(code.textContent ?? '');
			} catch (error) {
				status.textContent = 'Copy failed. Select the text to copy manually.';
				console.error('Unable to copy article code block.', error);
				return;
			} finally {
				copy.disabled = false;
			}

			toolbar.dataset.copyState = 'success';
			status.textContent = 'Copied.';
			if (
				!window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
				typeof check.animate === 'function'
			) {
				feedbackAnimations = [
					check.animate(
						[
							{ transform: 'scale(0.75)', opacity: 0 },
							{ transform: 'scale(1.1)', opacity: 1, offset: 0.7 },
							{ transform: 'scale(1)', opacity: 1 },
						],
						{ duration: 260, easing: 'ease-out' },
					),
					checkPath.animate(
						[{ strokeDashoffset: '24' }, { strokeDashoffset: '0' }],
						{ duration: 240, easing: 'ease-out' },
					),
				];
			}
			successTimeout = window.setTimeout(resetFeedback, 2400);
		});

		if (!pre.hasAttribute('tabindex')) pre.tabIndex = 0;
		pre.before(wrapper);
		toolbar.append(feedback, copy);
		wrapper.append(toolbar, pre);
	});
</script>

<style is:global>
