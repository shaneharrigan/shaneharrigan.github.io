		stroke-dasharray: 24;
		stroke-dashoffset: 0;
	}
	.prose .code-block-toolbar button {
		flex: 0 0 auto;
		min-height: 2.2rem;
		padding: 0.45rem 0.75rem;
		border: 1px solid transparent;
