---
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
}

const chapters = Astro.props.headings.filter(
	({ depth, slug }) =>
		depth === 2 && slug !== 'footnote-label' && slug !== 'user-content-footnote-label',
);
---

{
	chapters.length > 1 && (
		<nav class="chapter-navigation" aria-label="Article sections" data-chapter-navigation>
			<details class="chapter-menu">
				<summary>On this page</summary>
				<ol class="chapter-menu-list">
					{chapters.map(({ slug, text }) => (
						<li>
							<a href={`#${slug}`} data-chapter-link data-chapter-title={text}>
								{text}
							</a>
						</li>
					))}
				</ol>
			</details>
			<ol class="chapter-rail">
				{chapters.map(({ slug, text }) => (
					<li>
						<a href={`#${slug}`} data-chapter-link data-chapter-title={text}>
							<span class="chapter-bar" aria-hidden="true" />
							<span class="sr-only">{text}</span>
						</a>
					</li>
				))}
			</ol>
			<span class="chapter-tooltip" data-chapter-tooltip aria-hidden="true" />
		</nav>
	)
}

<script>
	const navigation = document.querySelector<HTMLElement>('[data-chapter-navigation]');

	if (navigation) {
		const links = Array.from(
			navigation.querySelectorAll<HTMLAnchorElement>('[data-chapter-link]'),
		);
		const menu = navigation.querySelector<HTMLDetailsElement>('.chapter-menu');
		const tooltip = navigation.querySelector<HTMLElement>('[data-chapter-tooltip]');
		const wideScreen = window.matchMedia('(min-width: 1080px)');
		const targets = new Map<string, HTMLElement>();

		for (const link of links) {
			const id = decodeURIComponent(link.hash.slice(1));
			const heading = document.getElementById(id);
			if (heading) {
				targets.set(link.hash, heading);
			} else {
				console.warn(`Article navigation target not found: ${link.hash}`);
			}
		}

		const hideLabel = () => {
			if (tooltip) delete tooltip.dataset.visible;
		};

		const showLabel = (link: HTMLAnchorElement) => {
			if (!tooltip || !wideScreen.matches) return;
			tooltip.textContent = link.dataset.chapterTitle ?? link.textContent;
			const bounds = link.getBoundingClientRect();
			tooltip.style.right = `${window.innerWidth - bounds.left + 12}px`;
			tooltip.style.top = '0px';
			const height = tooltip.getBoundingClientRect().height;
			const top = bounds.top + (bounds.height - height) / 2;
			tooltip.style.top = `${Math.max(12, Math.min(top, window.innerHeight - height - 12))}px`;
			tooltip.dataset.visible = 'true';
		};

		const revealTarget = (target: HTMLElement) => {
			let ancestor = target.parentElement;
			while (ancestor) {
				if (ancestor instanceof HTMLDetailsElement) ancestor.open = true;
				ancestor = ancestor.parentElement;
			}
		};

		let scheduled = false;
		const updateCurrent = () => {
			scheduled = false;
			const visibleTargets = Array.from(targets).filter(
				([, heading]) => heading.getClientRects().length > 0,
			);
			let current = visibleTargets[0]?.[0];
			const threshold = Math.min(160, window.innerHeight / 4);
			for (const [hash, heading] of visibleTargets) {
				if (heading.getBoundingClientRect().top <= threshold) current = hash;
			}
			for (const link of links) {
				if (link.hash === current) link.setAttribute('aria-current', 'location');
				else link.removeAttribute('aria-current');
			}
		};
		const scheduleUpdate = () => {
			if (!scheduled) {
				scheduled = true;
				window.requestAnimationFrame(updateCurrent);
			}
		};

		for (const link of links) {
			link.addEventListener('mouseenter', () => showLabel(link));
			link.addEventListener('mouseleave', () => {
				if (document.activeElement !== link) hideLabel();
			});
			link.addEventListener('focus', () => showLabel(link));
			link.addEventListener('blur', hideLabel);
			link.addEventListener('click', (event) => {
				if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
					return;
				}
				const target = targets.get(link.hash);
				if (!target) return;
				revealTarget(target);
				if (menu) menu.open = false;
				target.tabIndex = -1;
				target.focus({ preventScroll: true });
				hideLabel();
				scheduleUpdate();
			});
		}

		const revealFragment = () => {
			const target = targets.get(window.location.hash);
			if (target) revealTarget(target);
			scheduleUpdate();
		};

		window.addEventListener('scroll', scheduleUpdate, { passive: true });
		window.addEventListener('resize', () => {
			hideLabel();
			scheduleUpdate();
		});
		window.addEventListener('hashchange', revealFragment);
		document.addEventListener('toggle', scheduleUpdate, true);
		navigation.querySelector('.chapter-rail')?.addEventListener('scroll', hideLabel, { passive: true });
		wideScreen.addEventListener('change', hideLabel);
		const prose = navigation.closest('.prose');
		if (prose) new ResizeObserver(scheduleUpdate).observe(prose);
		revealFragment();
	}
</script>

<style>
	.chapter-navigation {
		position: fixed;
		z-index: 6;
		top: 4rem;
		right: max(1.25rem, calc((100vw - 760px) / 2 - 8rem));
		bottom: 4rem;
		display: flex;
		align-items: center;
		width: 3rem;
		pointer-events: none;
	}
	.chapter-menu {
		display: none;
	}
	.chapter-rail {
		width: 100%;
		max-height: 100%;
		margin: 0;
		padding: 0.4rem 0;
		overflow-y: auto;
		list-style: none;
		scrollbar-width: thin;
		pointer-events: auto;
	}
	.chapter-rail a {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		box-sizing: border-box;
		min-height: 28px;
		padding: 0.35rem 0.4rem;
		border-radius: 4px;
	}
	.chapter-bar {
		width: 1.25rem;
		height: 3px;
		border-radius: 999px;
		background: rgba(var(--gray), 45%);
		transition: width 140ms ease, background 140ms ease;
	}
	.chapter-rail a[aria-current] .chapter-bar,
	.chapter-rail a:hover .chapter-bar,
	.chapter-rail a:focus-visible .chapter-bar {
		width: 2rem;
		background: var(--accent);
	}
	.chapter-rail a:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: -2px;
	}
	.chapter-tooltip {
		position: fixed;
		width: max-content;
		max-width: min(20rem, calc(100vw - 8rem));
		padding: 0.5rem 0.75rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 6px;
		background: #fff;
		box-shadow: 0 4px 16px rgba(var(--black), 10%);
		color: rgb(var(--gray-dark));
		font-size: 0.85rem;
		line-height: 1.4;
		text-align: right;
		opacity: 0;
		visibility: hidden;
		transition: opacity 140ms ease;
	}
	.chapter-tooltip[data-visible] {
		opacity: 1;
		visibility: visible;
	}
	@media (max-width: 1079px) {
		.chapter-navigation {
			position: sticky;
			top: 0.5rem;
			right: auto;
			bottom: auto;
			display: block;
			width: auto;
			margin-bottom: 2rem;
			border: 1px solid rgb(var(--gray-light));
			border-radius: 10px;
			background: rgba(255, 255, 255, 97%);
			box-shadow: 0 4px 12px rgba(var(--black), 5%);
			pointer-events: auto;
		}
		.chapter-navigation .chapter-menu {
			display: block;
			margin: 0;
			padding: 0;
			border: 0;
			background: transparent;
		}
		.chapter-navigation .chapter-menu > summary {
			margin: 0;
			padding: 0.7rem 0.9rem;
			border: 0;
			font-size: 0.9rem;
		}
		.chapter-menu-list {
			max-height: min(60svh, 24rem);
			margin: 0;
			padding: 0.3rem;
			overflow-y: auto;
			list-style: none;
		}
		.chapter-menu-list a {
			display: block;
			padding: 0.5rem 0.7rem;
			border-radius: 5px;
			color: rgb(var(--gray-dark));
			font-size: 0.9rem;
			line-height: 1.4;
			text-decoration: none;
		}
		.chapter-menu-list a[aria-current],
		.chapter-menu-list a:hover {
			background: #f1f3ff;
			color: var(--accent-dark);
		}
		.chapter-menu-list a:focus-visible {
			outline: 2px solid var(--accent);
			outline-offset: -2px;
		}
		.chapter-rail,
		.chapter-tooltip {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.chapter-bar,
		.chapter-tooltip {
			transition: none;
		}
	}
</style>
