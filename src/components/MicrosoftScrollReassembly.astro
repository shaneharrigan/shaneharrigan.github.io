<div class="reassembly" aria-hidden="true" data-microsoft-reassembly>
	<div class="mark">
		<span class="red" data-microsoft-target="red"></span>
		<span class="green" data-microsoft-target="green"></span>
		<span class="blue" data-microsoft-target="blue"></span>
		<span class="yellow" data-microsoft-target="yellow"></span>
	</div>
</div>

<style>
	.reassembly {
		display: none;
		justify-content: center;
		margin: 4rem 0 1rem;
		min-height: 2.2rem;
	}

	.reassembly.is-active {
		display: flex;
	}

	.mark {
		display: grid;
		grid-template-columns: repeat(2, 1rem);
		grid-template-rows: repeat(2, 1rem);
		gap: 0.12rem;
	}

	.mark span {
		opacity: 0;
	}

	.mark span.is-landed {
		opacity: 1;
	}

	.red {
		background: #f25022;
	}

	.green {
		background: #7fba00;
	}

	.blue {
		background: #00a4ef;
	}

	.yellow {
		background: #ffb900;
	}

	@media (prefers-reduced-motion: reduce) {
		.reassembly.is-active {
			display: none;
		}
	}
</style>

<script>
	const colours = ['red', 'green', 'blue', 'yellow'] as const;
	const colourValues = {
		red: '#f25022',
		green: '#7fba00',
		blue: '#00a4ef',
		yellow: '#ffb900',
	};

	const clamp = (value: number) => Math.min(1, Math.max(0, value));
	const lerp = (start: number, end: number, progress: number) =>
		start + (end - start) * progress;

	const source = document.querySelector<HTMLElement>('[data-microsoft-source]');
	const reassembly = document.querySelector<HTMLElement>('[data-microsoft-reassembly]');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	if (source && reassembly && !reducedMotion.matches) {
		reassembly.classList.add('is-active');

		const sources = new Map(
			colours.map((colour) => [
				colour,
				source.querySelector<HTMLElement>(`[data-microsoft-colour="${colour}"]`),
			]),
		);
		const targets = new Map(
			colours.map((colour) => [
				colour,
				reassembly.querySelector<HTMLElement>(`[data-microsoft-target="${colour}"]`),
			]),
		);
		const fallingSquares = new Map(
			colours.map((colour) => {
				const square = document.createElement('span');
				square.setAttribute('aria-hidden', 'true');
				Object.assign(square.style, {
					position: 'fixed',
					display: 'none',
					background: colourValues[colour],
					pointerEvents: 'none',
					zIndex: '20',
					willChange: 'left, top, transform',
				});
				document.body.append(square);
				return [colour, square];
			}),
		);
		const motion = {
			red: { start: 0.07, end: 0.94, arc: -90, turns: 1.25 },
			green: { start: 0.13, end: 0.97, arc: 95, turns: -1.5 },
			blue: { start: 0.19, end: 1, arc: -65, turns: 1.75 },
			yellow: { start: 0.01, end: 0.88, arc: 55, turns: -1.25 },
		};
		const confetti = new Map(
			colours.map((colour, colourIndex) => [
				colour,
				Array.from({ length: 8 }, (_, index) => {
					const piece = document.createElement('span');
					piece.setAttribute('aria-hidden', 'true');
					Object.assign(piece.style, {
						position: 'fixed',
						display: 'none',
						background: colourValues[colour],
						pointerEvents: 'none',
						zIndex: '19',
						willChange: 'left, top, transform, opacity',
					});
					document.body.append(piece);
					return {
						piece,
						birth: 0.08 + index * 0.1,
						duration: 0.22,
						drift: ((index + colourIndex) % 3 - 1) * (28 + index * 4),
						drop: 75 + ((index + colourIndex) % 4) * 28,
						size: 3 + ((index + colourIndex) % 3) * 2,
						spin: (index % 2 === 0 ? 1 : -1) * (180 + index * 35),
					};
				}),
			]),
		);

		let updatePending = false;

		const placeSquare = (
			square: HTMLElement,
			left: number,
			top: number,
			size: number,
			rotation: number,
		) => {
			square.style.display = 'block';
			square.style.left = `${left}px`;
			square.style.top = `${top}px`;
			square.style.width = `${size}px`;
			square.style.height = `${size}px`;
			square.style.transform = `rotate(${rotation}deg)`;
		};

		const pointOnPath = (
			sourceRect: DOMRect,
			targetRect: DOMRect,
			progress: number,
			arc: number,
		) => ({
			left:
				lerp(sourceRect.left, targetRect.left, progress) +
				Math.sin(Math.PI * progress) * arc,
			top:
				lerp(sourceRect.top, targetRect.top, progress) +
				Math.sin(Math.PI * progress) * Math.min(window.innerHeight * 0.36, 260),
		});

		const update = () => {
			const maximumScroll = document.documentElement.scrollHeight - window.innerHeight;
			const progress = maximumScroll > 0 ? clamp(window.scrollY / maximumScroll) : 0;

			colours.forEach((colour) => {
				const sourceSquare = sources.get(colour);
				const target = targets.get(colour);
				const square = fallingSquares.get(colour);
				if (!sourceSquare || !target || !square) return;

				const settings = motion[colour];
				const travelProgress = clamp(
					(progress - settings.start) / (settings.end - settings.start),
				);
				const sourceRect = sourceSquare.getBoundingClientRect();
				const targetRect = target.getBoundingClientRect();
				const hasStarted = progress > settings.start;
				const hasLanded = travelProgress >= 0.995;

				sourceSquare.style.opacity = hasStarted ? '0' : '';
				target.classList.toggle('is-landed', hasLanded);

				if (hasStarted && !hasLanded) {
					const point = pointOnPath(
						sourceRect,
						targetRect,
						travelProgress,
						settings.arc,
					);
					placeSquare(
						square,
						point.left,
						point.top,
						lerp(sourceRect.width, targetRect.width, travelProgress),
						travelProgress * settings.turns * 360,
					);
				} else {
					square.style.display = 'none';
				}

				for (const fragment of confetti.get(colour) ?? []) {
					const age = clamp(
						(travelProgress - fragment.birth) / fragment.duration,
					);
					if (hasStarted && age > 0 && age < 1 && !hasLanded) {
						const origin = pointOnPath(
							sourceRect,
							targetRect,
							fragment.birth,
							settings.arc,
						);
						placeSquare(
							fragment.piece,
							origin.left + fragment.drift * age,
							origin.top + fragment.drop * age,
							fragment.size,
							fragment.spin * age,
						);
						fragment.piece.style.opacity = `${1 - age}`;
					} else {
						fragment.piece.style.display = 'none';
					}
				}
			});
		};

		const requestUpdate = () => {
			if (updatePending) return;
			updatePending = true;
			window.requestAnimationFrame(() => {
				updatePending = false;
				update();
			});
		};

		window.addEventListener('scroll', requestUpdate, { passive: true });
		window.addEventListener('resize', requestUpdate);
		update();
	}
</script>
