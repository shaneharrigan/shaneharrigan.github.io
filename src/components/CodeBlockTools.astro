		background: transparent;
		color: var(--accent-dark);
		font: inherit;
		font-size: 0.8rem;
		font-weight: 700;
		line-height: 1.2;
		cursor: pointer;
		transition: background-color 140ms ease, border-color 140ms ease;
	}
	.prose .code-block-toolbar .code-copy-button {
		border-color: var(--accent);
		background: var(--accent);
		color: #fff;
	}
	.prose .code-block-toolbar button:hover {
		border-color: #d8dded;
		background: #fff;
	}
	.prose .code-block-toolbar .code-copy-button:hover {
		border-color: var(--accent-dark);
		background: var(--accent-dark);
	}
	.prose .code-block-toolbar[data-copy-state='success'] {
		border-bottom-color: #a3cfb1;
		background: #e6f4ea;
	}
	.prose .code-block-toolbar[data-copy-state='success'] .code-block-feedback,
	.prose .code-block-toolbar[data-copy-state='success'] .code-block-status {
		color: #166534;
	}
	.prose .code-block-toolbar[data-copy-state='success'] .code-copy-check {
		display: block;
	}
	.prose .code-block-toolbar[data-copy-state='success'] .code-copy-button {
		border-color: #166534;
		background: #166534;
	}
	.prose .code-block-toolbar[data-copy-state='success'] .code-copy-button:hover {
		border-color: #14532d;
		background: #14532d;
	}
	.prose .code-block-toolbar button:focus-visible {
		outline: 2px solid var(--accent);
