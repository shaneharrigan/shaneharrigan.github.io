			</a>
			<a href="https://www.linkedin.com/in/shane-harrigan-1a2993303/" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">LinkedIn</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24">
					<path fill="currentColor" d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.148V6.169H2.542v7.125h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm9.614 8.212V9.359c0-1.401-.505-2.371-1.745-2.371-1.003 0-1.594.676-1.856 1.327-.095.231-.12.554-.12.878v4.961h-2.4V6.169h2.4v1.018c.28-.436.781-1.054 1.897-1.054 1.384 0 2.823.921 2.823 2.898v6.162h-2.4z"></path>
				</svg>
			</a>
		</div>
	</div>
</footer>

<style>
	footer {
		padding: 2rem 1rem;
		text-align: center;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.footer-content {
		max-width: 600px;
		margin: 0 auto;
	}
	footer p {
		margin: 0 0 1rem 0;
		font-size: 0.9rem;
		color: rgb(var(--gray));
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1.5rem;
	}
	.social-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		color: rgb(var(--gray));
		text-decoration: none;
		transition: color 0.2s;
	}
	.social-links a:hover {
		color: rgb(var(--gray-dark));
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border-width: 0;
	}
</style>
